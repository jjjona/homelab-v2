services:
  opportunities:
    image: opportunities:{{ opportunities_revision }}
    build: ./releases/{{ opportunities_revision }}
    container_name: opportunities
    restart: unless-stopped
    user: "1000:1000"
    init: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    ports:
      - "192.168.0.165:{{ opportunities_port }}:3000"
    environment:
      HOST: 0.0.0.0
      PORT: "3000"
      PUBLIC_ORIGIN: "https://{{ opportunities_host }}"
      AUTH_EMAIL: {{ hq_secrets.hq_allowed_email | to_json }}
      DATA_DIR: /data
      REPORTS_DIR: /reports
      PI_CODING_AGENT_DIR: /home/bun/.pi/agent
      # The app refreshes the native catalog only if its required model is missing.
      PI_TELEMETRY: "0"
      LLM_MAX_CALLS_PER_RUN: "16"
      MINER_UTC_HOUR: "6"
    volumes:
      - ./data:/data
      - ./reports:/reports
      - ./pi:/home/bun/.pi/agent
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
